<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <android.opengl.GLSurfaceView
        android:id="@+id/surfaceview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/label_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="#80000000"
        android:padding="10dp"
        android:text="Waiting for localization..."
        android:textColor="#FFFFFF" />

    <!-- [新增] 重定位误差调试信息 -->
    <TextView
        android:id="@+id/tv_relocalize_debug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_status"
        android:layout_marginTop="8dp"
        android:background="#A0FF0000"
        android:padding="6dp"
        android:text="Reloc Error: --"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 仅 Debug 窄门实拍测试模式显示。 -->
    <TextView
        android:id="@+id/tv_narrow_door_test_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tv_relocalize_debug"
        android:layout_marginTop="8dp"
        android:background="#D0000000"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:textColor="#7CFF9B"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ToggleButton
            android:id="@+id/toggle_show_path_nodes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="#A0000000"
            android:checked="false"
            android:textColor="#FFFFFF"
            android:textOff="Show Path"
            android:textOn="Hide Path" />

        <Button
            android:id="@+id/btn_localize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Localize" />

        <Button
            android:id="@+id/btn_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#FF4081"
            android:text="Voice" />

        <Button
            android:id="@+id/btn_select_dest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Navigate" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:background="#80000000"
        android:contentDescription="Settings"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_settings" />

    <!-- 仅 Debug 构建显示；开启真实相机/Depth 窄门测试，不访问服务器。 -->
    <Button
        android:id="@+id/btn_narrow_door_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/btn_settings"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="#80000000"
        android:text="窄门测试"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btn_language"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_alignTop="@id/btn_settings"
        android:layout_toStartOf="@id/btn_settings"
        android:layout_marginEnd="8dp"
        android:background="#80000000"
        android:minWidth="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="EN"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tv_debug_coords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="#A0000000"
        android:padding="8dp"
        android:text="Debug Coords"
        android:textColor="#00FF00"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

</RelativeLayout>
